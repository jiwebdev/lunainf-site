---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhitePaperPart1 from '../components/whitepaper/WhitePaperPart1.astro';
import WhitePaperPart2 from '../components/whitepaper/WhitePaperPart2.astro';
import WhitePaperPart3 from '../components/whitepaper/WhitePaperPart3.astro';
---
<BaseLayout
  title="LUNA White Paper v0.1 — A Longitudinal Architecture for Developmental Artificial Cognition"
  description="The complete public technical white paper for LUNA: longitudinal cognitive architecture, persistent causal history, developmental artificial cognition, and the ChronoForge experimental program."
>
  <section class="page-hero wp-hero">
    <div class="shell">
      <p class="eyebrow">PROJECT LUNA · PUBLIC TECHNICAL WHITE PAPER · v0.1 · 23 AUGUST 2026</p>
      <h1>A Longitudinal Architecture for Developmental Artificial Cognition</h1>
      <p class="section-lede">LUNA — Longitudinal Unified Narrative Architecture</p>
      <p class="section-lede">Cognitive infrastructure for artificial systems that develop through memory, experience, continuity, and time.</p>
      <div class="wp-meta-grid">
        <div><span>Version</span><strong>0.1</strong></div>
        <div><span>Date</span><strong>23 August 2026</strong></div>
        <div><span>Author</span><strong>Nathan Meloul — Project LUNA</strong></div>
        <div><span>Status</span><strong>Public research white paper</strong></div>
      </div>
      <div class="status-note">
        <strong>Open research. Protected implementation.</strong> This paper explains the research thesis, conceptual architecture, current prototype boundary, and experimental program without disclosing reproduction-critical implementation details.
      </div>
      <div class="page-actions">
        <a class="button button-primary" href="#abstract">Read the complete web edition</a>
      </div>
    </div>
  </section>
  <section class="section wp-paper-section">
    <article class="shell whitepaper-prose">
      <WhitePaperPart1 />
      <WhitePaperPart2 />
      <WhitePaperPart3 />
      <div class="wp-end-actions">
        <a class="button button-primary" href="/research">Continue to the research library</a>
      </div>
    </article>
  </section>
</BaseLayout>
