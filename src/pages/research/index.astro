<BaseLayout
  title="Research — LUNA"
  description="Research notes, observations, experiments, and architecture questions from the LUNA longitudinal cognitive architecture project."
>
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow">LUNA RESEARCH</p>
      <h1>Evidence before mythology.</h1>
      <p class="section-lede">
        Versioned observations, architectural questions, controlled experiments, and
        falsifiable predictions about persistent, history-dependent artificial cognition.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <p class="eyebrow">EARLY LUNA EXPERIENCES</p>
      <div class="research-list">
        <a class="research-item" href="/research/when-memory-is-not-enough">
          <div class="meta">August 2026<br />LUNA Core v0.5</div>
          <div>
            <h2>When Memory Is Not Enough: Can an AI Be Changed by Experience?</h2>
            <p>
              An early observation on retrieval, autobiographical creation, and the
              difference between remembering something and being shaped by it.
            </p>
          </div>
          <div class="arrow">→</div>
        </a>
      </div>

      <div class="status-strip">
        <strong>Publication policy</strong>
        <span>Internal research notes are rewritten for public release. Private implementation details, identifiers, prompts, and reproduction-critical mechanics are not published.</span>
